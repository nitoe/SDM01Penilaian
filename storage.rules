rules_version = '2';

// Firebase Storage — tanda tangan digital rapor STS + PDF perpustakaan + LMS
// Deploy: firebase deploy --only storage
// Path:
//   tanda-tangan/kepsek.png
//   tanda-tangan/stempel.png
//   tanda-tangan/guru/{uid}.png   ← nama file = uid + ".png"
//   perpus_digital/{uid}/{file}    ← PDF bacaan digital (unggah staf, baca publik)
//   lms/materi/{kelas}/{fileName}
//   lms/kuis/{kuisId}/{fileName}
//   lms/tugas/{tugasId}/{fileName}       ← lampiran guru (ANTIREGRESI §Tugas.Lampiran)
//   lms/pengumpulan/{tugasId}/{fileName} ← video bukti siswa (ANTIREGRESI §Tugas.Video)

service firebase.storage {
  match /b/{bucket}/o {
    // Akun STAF/orang tua (Firebase Auth email). Token siswa LMS (custom token dengan claim
    // lmsSiswa) SENGAJA tidak dianggap «login», agar siswa tidak bisa membaca/mengubah file staf.
    // Siswa membuka materi lewat download URL bertoken (tidak melewati rules).
    function isLoggedIn() {
      return request.auth != null && !('lmsSiswa' in request.auth.token);
    }

    function isSiswaLms() {
      return request.auth != null
        && 'lmsSiswa' in request.auth.token
        && request.auth.token.lmsSiswa == true
        && 'siswaId' in request.auth.token
        && request.auth.token.siswaId is string
        && request.auth.token.siswaId.size() > 0;
    }

    function isAdmin() {
      return isLoggedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && (
          !('aktif' in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data)
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.aktif == true
        );
    }

    // Semua jenis guru + admin (selaras isGuru() di firestore.rules; bukan orang tua). Dipakai baca video pengumpulan — orang tua
    // tidak boleh mengakses berkas video siswa lewat rules (ANTIREGRESI §Tugas.Video.6).
    function guruStorage() {
      return isLoggedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'guru', 'guru_akademik', 'guru_tahsin_tahfizh']
        && (
          !('aktif' in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data)
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.aktif == true
        );
    }

    function gambarSah() {
      return request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function pdfSah() {
      return request.resource.size < 40 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    match /tanda-tangan/{allPaths=**} {
      allow read: if isLoggedIn();
    }

    match /tanda-tangan/kepsek.png {
      allow write: if isAdmin() && gambarSah();
      allow delete: if isAdmin();
    }

    match /tanda-tangan/stempel.png {
      allow write: if isAdmin() && gambarSah();
      allow delete: if isAdmin();
    }

    // fileName = "{uid}.png" — jangan match {uid} saja (akan membandingkan uid dengan "uid.png")
    match /tanda-tangan/guru/{fileName} {
      allow write: if isLoggedIn()
        && fileName == request.auth.uid + '.png'
        && gambarSah();
      allow delete: if isLoggedIn()
        && fileName == request.auth.uid + '.png';
    }

    // PDF bacaan digital perpustakaan.
    // Staf yang login hanya boleh menulis ke folder uid-nya sendiri.
    // Baca diizinkan publik agar pembaca modal siswa (tanpa Auth) bisa memuat PDF.
    match /perpus_digital/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if isLoggedIn()
        && uid == request.auth.uid
        && pdfSah();
      allow delete: if isLoggedIn()
        && (uid == request.auth.uid || isAdmin());
    }


    // LMS materi: PDF / gambar / video
    // Path: lms/materi/{kelas}/{fileName}
    // Batas: gambar/pdf 10 MB, video 50 MB. Baca: staf login; tulis: staf login.
    // Penegakan penugasan di app + firestore.rules (metadata di lms_materi).
    function lmsGambarAtauPdf() {
      return request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
    }
    function lmsVideo() {
      return request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    match /lms/materi/{kelas}/{fileName} {
      allow read: if isLoggedIn();
      allow create, update: if isLoggedIn()
        && (lmsGambarAtauPdf() || lmsVideo())
        && fileName.size() > 0
        && fileName.size() <= 200;
      allow delete: if isLoggedIn();
    }



    // Gambar soal modul Kuis (lms_soal). Hanya staf (bukan token siswa LMS).
    // Path: lms/kuis/{kuisId}/{fileName} — maks 5 MB, image only.
    function lmsGambarKuis() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /lms/kuis/{kuisId}/{fileName} {
      allow read: if isLoggedIn();
      allow create, update: if isLoggedIn()
        && lmsGambarKuis()
        && kuisId.size() > 0
        && kuisId.size() <= 80
        && fileName.size() > 0
        && fileName.size() <= 200;
      allow delete: if isLoggedIn();
    }

    // ---- Lampiran tugas guru (ANTIREGRESI §Tugas.Lampiran) --------------------
    // Path: lms/tugas/{tugasId}/{id}_{nama}
    // Tulis: staf login. Baca: publik (siswa unduh lewat URL bertoken getDownloadURL).
    // Batas 50 MB per berkas (selaras klien).
    match /lms/tugas/{tugasId}/{fileName} {
      allow read: if true;
      allow create, update: if isLoggedIn()
        && tugasId.size() > 0
        && tugasId.size() <= 100
        && fileName.size() > 0
        && fileName.size() <= 220
        && request.resource.size < 50 * 1024 * 1024;
      allow delete: if isLoggedIn();
    }

    // ---- Video bukti pengumpulan siswa (ANTIREGRESI §Tugas.Video) ------------
    // Path: lms/pengumpulan/{tugasId}/{siswaId}_{slot}.{webm|mp4}
    // Nama berkas WAJIB diawali claim siswaId + '_' + slot 1..10 + ekstensi.
    // Ukuran ≤ 100 MB (tanpa batas durasi, ANTIREGRESI LMS §Tugas.Video.Ukuran); tipe video/webm atau video/mp4 saja.
    // Siswa: create/update/delete hanya miliknya, tugas aktif, belum dinilai.
    // Baca: pemilik (siswa) atau guru/admin (guruStorage) — BUKAN isLoggedIn() (orang tua).
    // Maks. 2 panggilan firestore per evaluasi (satu get tugas, satu exists nilai).

    function videoPengumpulanSah() {
      return request.resource.size > 0
        && request.resource.size <= 100 * 1024 * 1024
        && (request.resource.contentType == 'video/webm'
            || request.resource.contentType == 'video/mp4');
    }

    // Nama: {siswaId}_{1..10}.webm|mp4  (siswaId dari claim token).
    function namaVideoSiswa(fileName) {
      return fileName.matches('^' + request.auth.token.siswaId + '_(10|[1-9])\\.(webm|mp4)$');
    }

    // Tugas aktif + siswa belum dinilai. Satu get + satu exists (batas Storage rules).
    function siswaBolehKelolaVideo(tugasId) {
      let t = firestore.get(/databases/(default)/documents/lms_tugas/$(tugasId)).data;
      return t.aktif == true
        && !('selesai' in t && t.selesai == true)
        // Tutup otomatis saat tenggat (+ toleransi 5 menit) — sama dengan firestore.rules.
        && !('tutupSetelahTenggat' in t && t.tutupSetelahTenggat == true
             && 'tenggat' in t && t.tenggat is timestamp
             && request.time > t.tenggat + duration.value(5, 'm'))
        && !firestore.exists(/databases/(default)/documents/lms_nilai_tugas/$(tugasId + '_' + request.auth.token.siswaId));
    }

    match /lms/pengumpulan/{tugasId}/{fileName} {
      allow read: if (isSiswaLms()
                      && fileName.matches('^' + request.auth.token.siswaId + '_.*'))
                  || guruStorage();

      allow create, update: if isSiswaLms()
        && tugasId.size() > 0
        && tugasId.size() <= 100
        && namaVideoSiswa(fileName)
        && videoPengumpulanSah()
        && siswaBolehKelolaVideo(tugasId);

      // Hapus (ganti/reset): pemilik sebelum dinilai, atau guru/admin.
      allow delete: if (isSiswaLms()
                        && namaVideoSiswa(fileName)
                        && siswaBolehKelolaVideo(tugasId))
                    || guruStorage()
                    || isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
