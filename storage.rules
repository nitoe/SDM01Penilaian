rules_version = '2';

// Firebase Storage — tanda tangan digital rapor STS + PDF perpustakaan
// Deploy: firebase deploy --only storage
// Path:
//   tanda-tangan/kepsek.png
//   tanda-tangan/stempel.png
//   tanda-tangan/guru/{uid}.png   ← nama file = uid + ".png"
//   perpus_digital/{uid}/{file}    ← PDF bacaan digital (unggah staf, baca publik)

service firebase.storage {
  match /b/{bucket}/o {
    function isLoggedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isLoggedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && (
          !('aktif' in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data)
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.aktif == true
        );
    }

    function gambarSah() {
      return request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function pdfSah() {
      return request.resource.size < 40 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    match /tanda-tangan/{allPaths=**} {
      allow read: if isLoggedIn();
    }

    match /tanda-tangan/kepsek.png {
      allow write: if isAdmin() && gambarSah();
      allow delete: if isAdmin();
    }

    match /tanda-tangan/stempel.png {
      allow write: if isAdmin() && gambarSah();
      allow delete: if isAdmin();
    }

    // fileName = "{uid}.png" — jangan match {uid} saja (akan membandingkan uid dengan "uid.png")
    match /tanda-tangan/guru/{fileName} {
      allow write: if isLoggedIn()
        && fileName == request.auth.uid + '.png'
        && gambarSah();
      allow delete: if isLoggedIn()
        && fileName == request.auth.uid + '.png';
    }

    // PDF bacaan digital perpustakaan.
    // Staf yang login hanya boleh menulis ke folder uid-nya sendiri.
    // Baca diizinkan publik agar pembaca modal siswa (tanpa Auth) bisa memuat PDF.
    match /perpus_digital/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if isLoggedIn()
        && uid == request.auth.uid
        && pdfSah();
      allow delete: if isLoggedIn()
        && (uid == request.auth.uid || isAdmin());
    }


    // LMS materi: PDF / gambar / video
    // Path: lms/materi/{kelas}/{fileName}
    // Batas: gambar/pdf 10 MB, video 50 MB. Baca: staf login; tulis: staf login.
    // Penegakan penugasan di app + firestore.rules (metadata di lms_materi).
    function lmsGambarAtauPdf() {
      return request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
    }
    function lmsVideo() {
      return request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    match /lms/materi/{kelas}/{fileName} {
      allow read: if isLoggedIn();
      allow create, update: if isLoggedIn()
        && (lmsGambarAtauPdf() || lmsVideo())
        && fileName.size() > 0
        && fileName.size() <= 200;
      allow delete: if isLoggedIn();
    }


    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
