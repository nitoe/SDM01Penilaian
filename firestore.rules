rules_version = '2';

// ============================================================================
// Firestore Security Rules — SDM 01 Kukusan (sdm01kukusan-2e735)
//
// Model akses (disederhanakan untuk scaffold):
//   - Hanya user yang punya dokumen di koleksi `users` yang boleh akses.
//   - role "admin"          → akses penuh
//   - role "guru"           → baca/tulis data sesuai modul & kelasAmpu
//   - role "orangtua"       → baca data anak sendiri (jika status approved)
//
// Aturan akan diperhalus saat migrasi modul Tahsin & Akademik.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isLoggedIn() && myProfile().role == 'admin';
    }

    function isGuru() {
      return isLoggedIn() && myProfile().role in ['admin', 'guru', 'guru_tahsin_tahfizh', 'guru_akademik'];
    }

    function isApprovedParent() {
      return isLoggedIn()
        && myProfile().role == 'orangtua'
        && myProfile().status == 'approved';
    }

    // Profil user sendiri — boleh baca; tulis terbatas (admin saja untuk role)
    match /users/{uid} {
      allow read: if isLoggedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isLoggedIn() && request.auth.uid == uid;
      allow update: if isAdmin()
        || (isLoggedIn() && request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['role', 'status', 'kelasAmpu', 'penugasan']));
      allow delete: if isAdmin();
    }

    // Data siswa — guru & admin
    match /students/{id} {
      allow read: if isGuru() || isApprovedParent();
      allow write: if isAdmin() || isGuru();
    }

    // Modul Tahsin-Tahfizh (placeholder)
    match /setoran/{id} {
      allow read, write: if isGuru();
    }
    match /target_hafalan/{id} {
      allow read, write: if isGuru();
    }

    // Modul Akademik (placeholder)
    match /mapel/{id} {
      allow read, write: if isGuru();
    }
    match /tp_kktp/{id} {
      allow read, write: if isGuru();
    }
    match /nilai/{id} {
      allow read, write: if isGuru();
    }

    // Default: tolak semua yang belum didefinisikan
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
