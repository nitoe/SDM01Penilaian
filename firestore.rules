rules_version = '2';

// Firestore Security Rules — SDM 01 Kukusan (sdm01kukusan-2e735)
// Koleksi Tahsin: siswa, setoran, target_hafalan, menulis_log, kktp_tahsin_tahfizh

service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isLoggedIn() && myProfile().role == 'admin';
    }

    function isGuru() {
      return isLoggedIn() && myProfile().role in [
        'admin', 'guru', 'guru_tahsin_tahfizh', 'guru_akademik'
      ];
    }

    function isApprovedParent() {
      return isLoggedIn()
        && myProfile().role == 'orangtua'
        && myProfile().status == 'approved';
    }

    match /users/{uid} {
      allow read: if isLoggedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isLoggedIn() && request.auth.uid == uid;
      allow update: if isAdmin()
        || (isLoggedIn() && request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['role', 'status', 'kelasAmpu', 'penugasan']));
      allow delete: if isAdmin();
    }

    match /siswa/{id} {
      allow read: if isGuru() || isApprovedParent();
      allow write: if isAdmin() || isGuru();
    }

    match /students/{id} {
      allow read: if isGuru() || isApprovedParent();
      allow write: if isAdmin() || isGuru();
    }

    match /setoran/{id} {
      allow read, write: if isGuru();
    }

    match /target_hafalan/{id} {
      allow read, write: if isGuru();
    }

    match /menulis_log/{id} {
      allow read, write: if isGuru();
    }

    match /kktp_tahsin_tahfizh/{id} {
      allow read: if isGuru();
      allow write: if isAdmin();
    }

    match /mapel/{id} {
      allow read, write: if isGuru();
    }
    match /tp_kktp/{id} {
      allow read, write: if isGuru();
    }
    match /nilai/{id} {
      allow read, write: if isGuru();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
